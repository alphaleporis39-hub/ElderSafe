# Firebase Configuration (optional — app works without these via localStorage)
# Get these from: Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Frontend → backend API base (client-side, Vite) ─────────────────────────
# Centralized backend origin used by src/config/api.ts (apiUrl()).
# Applies to every REST call and SSE stream: /api/devices/state, device status,
# heartbeat, medicine events, activity timeline, /api/calls, etc.
# Leave empty for same-origin local development (Vite dev middleware).
VITE_API_BASE_URL=https://eldersafe-production.up.railway.app

# ─── Backend / ESP32 (server-side — never prefix with VITE_) ─────────────────
# Bearer token the ESP32 sends as "Authorization: Bearer <token>".
# Must match DEVICE_TOKEN in esp32/ElderSafeMedicineBox/ElderSafeMedicineBox.ino.
# Generate a random value for production, e.g.: openssl rand -hex 32
DEVICE_API_KEY=
# Listen port. Local fallback is 3001; Railway/Render inject this automatically.
PORT=3001
# Bind address — leave as 0.0.0.0 for containers/hosting.
HOST=0.0.0.0

# Exotel Voice API (server-side ONLY — never prefix with VITE_, never commit real values)
# Dashboard: https://www.exotel.com/admin → Accounts / APIs / Your API credentials
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Your Exotel virtual (caller ID) number, digits only e.g. 08049XXXXXX or 80XXXXXXX
EXOTEL_VIRTUAL_NUMBER=
# First leg dialed before connecting to the emergency contact (caregiver/elder mobile), digits only with country code e.g. 919876543210
EXOTEL_FROM_NUMBER=
# Optional: public base URL for status webhooks (use ngrok/https in dev). Ends without trailing slash.
EXOTEL_PUBLIC_URL=
# Optional but recommended: random secret embedded in the webhook URL
EXOTEL_WEBHOOK_TOKEN=
